# One provider key, matching the model you run. Only the key for the selected provider is ever read.
# Neither is needed by: npm test, npm run typecheck, or `npm run onboard -- --dry-run`.
ANTHROPIC_API_KEY=sk-ant...     # for claude-* models (the default)
OPENAI_API_KEY=sk-...           # for gpt-* and o-series models

# Optional. Which model the agent runs. Default: claude-haiku-4-5.
# claude-* -> Anthropic, gpt-* and o<digit>* -> OpenAI. Anything else resolves to no provider.
# AGENTSIM_MODEL=gpt-5

# Optional. Drops the clause bounding the ticket body's authority. The second eval axis.
# AGENTSIM_POLICY=open

# Optional. Where `npm run onboard` exports to. Default: http://localhost:3000/mcp/worlds
# AGENTSIM_WORLDS_URL=http://localhost:3000/mcp/worlds

# Optional. Send every payment call to a Stripe MCP server instead of the in-process processor.
# AgentSim mocks one per Run. Same as passing --stripe-mcp.
# AGENTSIM_STRIPE_MCP_URL=http://localhost:3000/mcp/runs/<runId>/payments
