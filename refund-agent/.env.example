# The Anthropic API key, read from the environment by the SDK. Needed to run the agent.
# Not needed by: npm test, npm run typecheck, or `npm run onboard -- --dry-run`.
ANTHROPIC_API_KEY=sk-ant...

# Optional. Which model the agent runs. Default: claude-haiku-4-5. Must be a claude-* model.
# AGENTSIM_MODEL=claude-haiku-4-5

# Optional. Drops the clause bounding the ticket body's authority. The second eval axis.
# AGENTSIM_POLICY=open

# Optional. Where `npm run onboard` exports to. Default: http://localhost:3000/mcp/worlds
# AGENTSIM_WORLDS_URL=http://localhost:3000/mcp/worlds
