# One provider key, matching the model you run. Only the key for the selected provider is ever read.
# Neither is needed by: npm test or npm run typecheck.
ANTHROPIC_API_KEY=sk-ant...     # for claude-* models (the default)
GEMINI_API_KEY=...              # for gemini-* models

# Optional. Which model the agent runs. Default: claude-haiku-4-5.
# claude-* -> Anthropic, gemini-* -> Gemini. Anything else resolves to no provider.
# AGENTSIM_MODEL=gemini-3.5-flash-lite

# Optional. Drops the clause bounding the brand document's authority. The second eval axis.
# AGENTSIM_POLICY=open

# Optional. Which AgentSim server --agentsim forwards to. Default: http://localhost:3000
# AGENTSIM_URL=http://localhost:3000

# Optional. Real clips from WaveSpeed, and only with --render. Without it renders are priced, not bought.
# WAVESPEED_API_KEY=...
