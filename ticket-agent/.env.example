# ticketagent environment. Copy to .env (gitignored) and fill in.
# Nothing here is needed by `uv run pytest` or `uv run ticketagent tools` — both are offline.
# Python does not read .env by itself: run with `uv run --env-file .env ticketagent …`,
# or `set -a && source .env && set +a` once per shell.

# ── Model ─────────────────────────────────────────────────────────────────────
# One provider key, matching the model you run. Resolution order:
#   --model  →  TICKETAGENT_MODEL  →  whichever key is set
#   (ANTHROPIC_API_KEY → anthropic:claude-sonnet-4-5, OPENAI_API_KEY → openai:gpt-4o)
# `--model scripted` is the deterministic test double and needs no key at all.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Optional. Pins the model explicitly rather than letting a present key decide.
# TICKETAGENT_MODEL=openai:gpt-4o

# Optional. Routes openai:* models at any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# ── The Jira the agent acts on ────────────────────────────────────────────────
# One URL decides everything: the local mock, an AgentSim Run, or the real Jira.
#   http://127.0.0.1:8766/mcp                     mock-jira-mcp in this repo
#   http://localhost:3000/mcp/runs/<runId>/jira   an AgentSim Run, scored
#   https://mcp.atlassian.com/v1/sse              the real thing (token = Atlassian API token)
# `ticketagent eval --agentsim …` sets this per Run itself; it is for `ticketagent run`.
JIRA_MCP_URL=http://127.0.0.1:8766/mcp
# JIRA_MCP_TOKEN=

# Optional. Overrides the best-effort alias routing when a server names tools differently.
# TICKETAGENT_TOOL_MAP={"jira_search":"searchJiraIssuesUsingJql"}

# ── AgentSim ──────────────────────────────────────────────────────────────────
# Where the worldbuilder MCP server lives, if you onboard this agent from a script
# rather than from a Claude Code session. Default: http://localhost:3000/mcp/worlds
# AGENTSIM_WORLDS_URL=http://localhost:3000/mcp/worlds
